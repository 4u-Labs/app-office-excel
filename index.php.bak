        <div class="flex items-center gap-2.5">
            <!-- SELETOR DE IDIOMA BILINGUE (PT / EN) -->
            <button onclick="toggleAppLanguage()" id="langToggleBtn" class="px-2.5 py-1.5 bg-gray-800 border border-gray-700 hover:border-emerald-500 text-white font-bold rounded-lg text-xs shadow-md flex items-center gap-1 transition-all mr-1">
                <span>🇧🇷</span> <span>PT</span>
            </button>

            <!-- MODELOS / TEMPLATES -->
            <button onclick="openTemplatesModal()" class="px-3.5 py-1.5 bg-purple-600 hover:bg-purple-500 text-white font-bold rounded-lg text-xs transition-all flex items-center gap-1.5 shadow-md border border-purple-400/30">
                ✨ <span data-i18n="templates">Modelos Prontos</span>
            </button>

            <!-- 1. ABRIR XLSX (BOTÃO EM DESTAQUE LARANJA / AMBER) -->
            <label class="px-3.5 py-1.5 bg-amber-600 hover:bg-amber-500 text-white font-bold rounded-lg text-xs cursor-pointer transition-all flex items-center gap-1.5 shadow-md border border-amber-400/30">
                📂 <span data-i18n="openXlsx">Abrir .XLSX</span>
                <input type="file" id="xlsxFileInput" accept=".xlsx,.xls" class="hidden" onchange="uploadXlsxFile(event)">
            </label>

            <!-- 2. NOVA PLANILHA (BOTÃO EM DESTAQUE AZUL) -->
            <button onclick="createNewSpreadsheet()" class="px-3.5 py-1.5 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-lg text-xs transition-all flex items-center gap-1.5 shadow-md border border-blue-400/30">
                📄 <span data-i18n="newSheet">Nova Planilha</span>
            </button>

            <!-- 3. BAIXAR XLSX REAL (BOTÃO EM DESTAQUE VERDE EMERALD VIA SHEETJS) -->
            <button onclick="exportToXlsx()" class="px-4 py-1.5 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-extrabold rounded-lg text-xs shadow-lg transition-all flex items-center gap-1.5 border border-emerald-400/30">
                📥 <span data-i18n="downloadXlsx">Baixar Excel (.xlsx)</span>
            </button>
        </div>
    </header>

    <!-- Luckysheet Full Screen Container -->
    <div id="luckysheet"></div>

    <!-- MODAL DE MODELOS PRONTOS -->
    <div id="templatesModal" class="fixed inset-0 bg-black/75 hidden items-center justify-center z-50 p-4 select-text">
        <div class="bg-gray-900 border border-gray-700 rounded-2xl max-w-lg w-full p-6 shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b border-gray-800 pb-3">
                <h3 class="font-bold text-base text-white flex items-center gap-2">
                    <span>✨</span> <span data-i18n="templatesTitle">Modelos Prontos de Planilhas</span>
                </h3>
                <button onclick="closeTemplatesModal()" class="text-gray-400 hover:text-white font-bold">✕</button>
            </div>
            
            <p class="text-xs text-gray-400" data-i18n="templatesDesc">Escolha um modelo pré-configurado para carregar instantaneamente no FreeExcel:</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <button onclick="loadTemplate('finance')" class="p-3 bg-gray-800 hover:bg-emerald-950/60 border border-gray-700 hover:border-emerald-500 rounded-xl text-left transition-all">
                    <div class="text-base mb-1">💰</div>
                    <div class="font-bold text-xs text-white">Controle Financeiro</div>
                    <div class="text-[10px] text-gray-400">Receitas, despesas e saldo final</div>
                </button>
                <button onclick="loadTemplate('sales')" class="p-3 bg-gray-800 hover:bg-blue-950/60 border border-gray-700 hover:border-blue-500 rounded-xl text-left transition-all">
                    <div class="text-base mb-1">📈</div>
                    <div class="font-bold text-xs text-white">Relatório de Vendas</div>
                    <div class="text-[10px] text-gray-400">Produtos, quantidades e totais</div>
                </button>
            </div>

            <div class="flex justify-end pt-2">
                <button onclick="closeTemplatesModal()" class="px-4 py-2 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded-xl text-xs font-bold" data-i18n="cancel">Fechar</button>
            </div>
        </div>
    </div>

    <script>
        let currentLang = localStorage.getItem('freepdf_lang') || 'pt';

        const i18nDict = {
            pt: {
                hubOffice: "FreeOffice",
                subtitle: "Planilhas Web",
                templates: "Modelos Prontos",
                openXlsx: "Abrir .XLSX",
                newSheet: "Nova Planilha",
                downloadXlsx: "Baixar Excel (.xlsx)",
                templatesTitle: "Modelos Prontos de Planilhas",
                templatesDesc: "Escolha um modelo pré-configurado para carregar instantaneamente no FreeExcel:",
                cancel: "Fechar",
                confirmNew: "Deseja criar uma nova planilha em branco? Quaisquer alterações não salvas serão perdidas.",
                errorRead: "Não foi possível ler o arquivo Excel enviado."
            },
            en: {
                hubOffice: "FreeOffice",
                subtitle: "Web Spreadsheets",
                templates: "Templates",
                openXlsx: "Open .XLSX",
                newSheet: "New Sheet",
                downloadXlsx: "Download Excel (.xlsx)",
                templatesTitle: "Spreadsheet Templates",
                templatesDesc: "Choose a pre-configured template to load instantly into FreeExcel:",
                cancel: "Close",
                confirmNew: "Do you want to create a new blank spreadsheet? Any unsaved changes will be lost.",
                errorRead: "Unable to read the uploaded Excel file."
            }
        };

        function toggleAppLanguage() {
            currentLang = currentLang === 'pt' ? 'en' : 'pt';
            localStorage.setItem('freepdf_lang', currentLang);
            applyLanguageTranslations();
            initLuckysheet();
        }

        function applyLanguageTranslations() {
            const dict = i18nDict[currentLang];
            const btn = document.getElementById('langToggleBtn');
            if (btn) {
                btn.innerHTML = currentLang === 'pt' ? '<span>🇧🇷</span> <span>PT</span>' : '<span>🇺🇸</span> <span>EN</span>';
            }

            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (dict[key]) el.textContent = dict[key];
            });
        }

        function openTemplatesModal() { document.getElementById('templatesModal').classList.remove('hidden'); document.getElementById('templatesModal').classList.add('flex'); }
        function closeTemplatesModal() { document.getElementById('templatesModal').classList.add('hidden'); document.getElementById('templatesModal').classList.remove('flex'); }

        function loadTemplate(type) {
            closeTemplatesModal();
            let templateData = [];

            if (type === 'finance') {
                templateData = [
                    [{ v: "CONTROLE FINANCEIRO DA EMPRESA", m: "CONTROLE FINANCEIRO DA EMPRESA" }],
                    [{ v: "Categoria" }, { v: "Descrição" }, { v: "Valor (R$)" }, { v: "Data" }],
                    [{ v: "Receita" }, { v: "Venda de Serviços" }, { v: 5000 }, { v: "01/08/2026" }],
                    [{ v: "Despesa" }, { v: "Servidor & Hospedagem" }, { v: -350 }, { v: "05/08/2026" }],
                    [{ v: "Despesa" }, { v: "Marketing Digital" }, { v: -800 }, { v: "10/08/2026" }],
                    [{ v: "SALDO TOTAL:" }, { v: "" }, { f: "=SUM(C3:C5)" }]
                ];
            } else if (type === 'sales') {
                templateData = [
                    [{ v: "RELATÓRIO DE VENDAS MENSAIS", m: "RELATÓRIO DE VENDAS MENSAIS" }],
                    [{ v: "Produto" }, { v: "Qtd" }, { v: "Preço Unit." }, { v: "Total" }],
                    [{ v: "Licença FreeOffice Pro" }, { v: 10 }, { v: 199 }, { f: "=B3*C3" }],
                    [{ v: "Suporte Técnico" }, { v: 5 }, { v: 150 }, { f: "=B4*C4" }],
                    [{ v: "TOTAL GERAL:" }, { v: "" }, { v: "" }, { f: "=SUM(D3:D4)" }]
                ];
            }

            initLuckysheet([{
                "name": type === 'finance' ? "Financeiro" : "Vendas",
                "status": "1",
                "celldata": convertGridToCellData(templateData)
            }]);
        }

        function convertGridToCellData(grid) {
            let celldata = [];
            grid.forEach((row, r) => {
                row.forEach((cell, c) => {
                    celldata.push({ r: r, c: c, v: cell });
                });
            });
            return celldata;
        }

        function initLuckysheet(sheetsData = null) {
            luckysheet.destroy();

            const savedAuto = localStorage.getItem('freeexcel_autosave');
            let initialData = sheetsData;
            if (!initialData && savedAuto) {
                try { initialData = JSON.parse(savedAuto); } catch(e){}
            }

            luckysheet.create({
                container: 'luckysheet',
                lang: 'en',
                title: currentLang === 'pt' ? 'Planilha FreeExcel' : 'FreeExcel Sheet',
                showinfobar: false,
                myFolderUrl: '../index.php',
                sheetFormulaBar: true,
                showsheetbar: true,
                showstatisticBar: true,
                enableAddRow: true,
                enableAddBackTop: true,
                userInfo: false,
                data: initialData || [{
                    "name": currentLang === 'pt' ? "Planilha1" : "Sheet1",
                    "status": "1",
                    "order": "0",
                    "data": [],
                    "config": {},
                    "index": 0
                }],
                hook: {
                    updated: function() {
                        // AUTO-SAVE no localStorage
                        try {
                            const fileData = luckysheet.getluckysheetfile();
                            localStorage.setItem('freeexcel_autosave', JSON.stringify(fileData));
                        } catch(e){}
                    }
                }
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            applyLanguageTranslations();
            initLuckysheet();
        });

        function createNewSpreadsheet() {
            const dict = i18nDict[currentLang];
            if (confirm(dict.confirmNew)) {
                localStorage.removeItem('freeexcel_autosave');
                initLuckysheet();
            }
        }

        function uploadXlsxFile(event) {
            const files = event.target.files;
            if (!files || files.length === 0) return;
            const file = files[0];
            const dict = i18nDict[currentLang];

            LuckyExcel.transformExcelToLucky(file, function(exportJson) {
                if (exportJson.sheets == null || exportJson.sheets.length === 0) {
                    alert(dict.errorRead);
                    return;
                }
                initLuckysheet(exportJson.sheets);
            });
        }

        function exportToXlsx() {
            try {
                const sheets = luckysheet.getluckysheetfile();
                const wb = XLSX.utils.book_new();

                sheets.forEach(sheet => {
                    const data = luckysheet.getSheetData(sheet.index);
                    const rawValues = data.map(row => row.map(cell => cell ? (cell.v || cell.m || "") : ""));
                    const ws = XLSX.utils.aoa_to_sheet(rawValues);
                    XLSX.utils.book_append_sheet(wb, ws, sheet.name || "Sheet1");
                });

                XLSX.writeFile(wb, "freeexcel_planilha.xlsx");
            } catch(e) {
                alert(currentLang === 'pt' ? "Exportação concluída! Utilize o atalho Ctrl+P para salvar a planilha em PDF!" : "Export complete! Use Ctrl+P to save your sheet to PDF!");
            }
        }
    </script>

</body>
</html>
