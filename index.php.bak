<body class="h-screen flex flex-col overflow-hidden select-none">

    <!-- Top Navigation Header -->
    <header class="bg-gray-900 border-b border-gray-800 h-14 px-4 flex items-center justify-between z-30 select-none">
        <div class="flex items-center gap-3">
            <a href="../index.php" class="text-gray-400 hover:text-white font-bold text-sm flex items-center gap-1.5 transition-colors">
                ← <span data-i18n="hubOffice">FreeOffice</span>
            </a>
            <span class="text-gray-700">|</span>
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-500 flex items-center justify-center text-white font-bold text-base shadow-lg shadow-emerald-500/20">
                    📊
                </div>
                <div class="flex flex-col">
                    <span class="font-extrabold text-sm text-white leading-none">Free<span class="text-emerald-400">Excel</span></span>
                    <span class="text-[9px] text-gray-400 font-bold uppercase tracking-wider mt-0.5" data-i18n="subtitle">Planilhas Web</span>
                </div>
            </div>
